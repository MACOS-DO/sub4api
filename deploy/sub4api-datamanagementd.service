[Unit]
Description=Sub4API Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=sub4api
Group=sub4api
WorkingDirectory=/opt/sub4api
ExecStart=/opt/sub4api/datamanagementd \
  -socket-path /tmp/sub2api-datamanagement.sock \
  -sqlite-path /var/lib/sub4api/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
